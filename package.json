    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-joi-validation": "^6.1.0",
    "http-errors": "~1.6.3",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.20.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
